# Patrimonasa — Plantilla del .env de PRODUCCIÓN (Loading)
# Cómo usarla (en el servidor, por SSH):
#   cp .env.production.example .env
#   edita DB_* con los datos reales y genera la clave con:
#   /ldnwebserver/php83/bin/php artisan key:generate --force
# Nunca guardes contraseñas reales en este archivo del repositorio.

APP_NAME=Patrimonasa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://patrimonio.casetashormigon.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos: MySQL del alojamiento (recomendado en producción).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Alternativa SQLite (solo si el alojamiento lo prefiere):
# DB_CONNECTION=sqlite
# DB_DATABASE=/patrimonio.casetashormigon.es/app/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@patrimonio.casetashormigon.es"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
